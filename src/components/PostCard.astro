---
import { useTranslations, type Lang } from '../i18n/ui';
import { formatDate, readingTime, type Post } from '../lib/posts';
import { url } from '../lib/url';

interface Props {
  post: Post;
  lang: Lang;
}

const { post, lang } = Astro.props;
const t = useTranslations(lang);
const { title, description, pubDate, tags, category, docNo } = post.data;
const minutes = readingTime(post.body, lang);
const badgeLabel = t(`category.${category}`);
---

<li>
  <a class="post-card" href={url(`${lang}/blog/${post.id}/`)}>
    <span class="post-card__side">
      <span class={`badge badge--${category}`}>{badgeLabel}</span>
      {docNo && <span class="post-card__docno">{docNo}</span>}
    </span>

    <div class="post-card__body">
      <h3 class="post-card__title">{title}</h3>
      {description && <p class="post-card__desc">{description}</p>}
      <div class="post-card__meta">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate, lang)}</time>
        <span>{minutes} {t('post.minutes')}</span>
        {tags.slice(0, 2).map((tag) => <span>#{tag}</span>)}
      </div>
    </div>

    <span class="post-card__arrow" aria-hidden="true">→</span>
  </a>
</li>

<style>
  /* 发文号另起一行，与徽标成对齐的档案栏 */
  .post-card__docno {
    display: block;
  }
</style>
