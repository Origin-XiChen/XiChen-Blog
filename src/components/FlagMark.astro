---
/**
 * 旗帜标记（矢量）
 *
 * 制式与纹章均取自 src/lib/flags.ts，与 public/flags/*.svg 同源：
 * 纵向双色旗面、中置鎏金五角星、星心嵌素白圆盘，盘上绘本旗纹章。
 */
import { FEDERAL_FLAG, FLAG, flagBody } from '../lib/flags';
import type { Domain } from '../config';

interface Props {
  class?: string;
  /** 无障碍名称；缺省时按旗主自动生成 */
  title?: string;
  /** 传入州域则绘该域域旗，否则绘联邦国旗 */
  domain?: Domain;
  /** 是否渲染无障碍名称，纯装饰处可置 false */
  decorative?: boolean;
}

const { class: className, title, domain, decorative = false } = Astro.props;

const flag = domain
  ? { hoist: domain.colors[0], fly: domain.colors[1], emblem: domain.emblem }
  : { hoist: FEDERAL_FLAG.hoist, fly: FEDERAL_FLAG.fly, emblem: FEDERAL_FLAG.emblem };

const label = title ?? (domain ? `${domain.name.zh}域旗` : '和星联邦国旗');

const body = flagBody(flag);
---

<svg
  class={className}
  viewBox={`0 0 ${FLAG.width} ${FLAG.height}`}
  role={decorative ? 'presentation' : 'img'}
  aria-label={decorative ? undefined : label}
  aria-hidden={decorative ? 'true' : undefined}
  preserveAspectRatio="xMidYMid meet"
><Fragment set:html={body} /></svg>
